{
  "manifest_version": 3,
  "name": "PBox Cinejoy Auto Sync",
  "version": "1.1.0",
  "description": "Syncs Pandora's Box lists to Cinejoy and Cinejoy playback progress back into Pandora's Box.",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
