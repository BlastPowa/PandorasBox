{
  "manifest_version": 3,
  "name": "Pandora's Box",
  "version": "1.3.4",
  "description": "Track movies, series, anime, manga and more while you browse and watch.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.themoviedb.org/*",
    "https://graphql.anilist.co/*",
    "https://api.mangadex.org/*",
    "https://api.jikan.moe/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Pandora's Box",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "pages/profile.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "content-scripts/netflix.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.disneyplus.com/*"
      ],
      "js": [
        "content-scripts/disneyplus.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.cinemaos.live/*"
      ],
      "js": [
        "content-scripts/cinemaos.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://cinejoy.to/*",
        "https://*.cinejoy.to/*",
        "https://cinejoy.pk/*",
        "https://*.cinejoy.pk/*"
      ],
      "js": [
        "content-scripts/cinejoy.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.crunchyroll.com/*"
      ],
      "js": [
        "content-scripts/crunchyroll.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mangadex.org/*"
      ],
      "js": [
        "content-scripts/mangadex.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.webtoons.com/*"
      ],
      "js": [
        "content-scripts/webtoon.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://www.netflix.com/*",
        "https://www.disneyplus.com/*",
        "https://*.cinemaos.live/*",
        "https://www.crunchyroll.com/*",
        "https://mangadex.org/*",
        "https://www.webtoons.com/*",
        "https://*.youtube.com/*",
        "https://youtu.be/*",
        "https://*.twitter.com/*",
        "https://*.x.com/*",
        "https://*.tiktok.com/*",
        "https://*.instagram.com/*",
        "https://*.facebook.com/*",
        "https://*.reddit.com/*",
        "https://*.twitch.tv/*"
      ],
      "js": [
        "content-scripts/universal.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
